# ==============================================================================
# MANDATEPAY CONTROL PLANE (TRUSTED ENVIRONMENT)
# Holds secrets, talks to PayPal Sandbox, issues and evaluates mandates
# ==============================================================================
PORT=3001
HOST=0.0.0.0
# DEMO_MODE=true # Uncomment for local demo to generate ephemeral owner token
DEMO_MODE=false
DB_PATH=./data/mandatepay.db

# PayPal Sandbox Credentials (Orders v2 API)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Cryptographic Keys & Owner Authorization
MANDATE_HMAC_KEY=replace_with_64_char_hex_hmac_secret_for_mandate_integrity
AGENT_TOKEN_SECRET=replace_with_secure_random_agent_bearer_token_secret
OWNER_TOKEN=your_32_char_hex_owner_token_here

# AI Studio runtime vars
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ==============================================================================
# AGENT PROCESS / COGNITIVE PLANE (UNTRUSTED RUNTIME)
# Autonomous shopper agent - NEVER receives PayPal tokens or payment credentials
# ==============================================================================
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-2.5-flash
CONTROL_PLANE_URL=http://localhost:3001
AGENT_TOKEN=mp_agt_demo_token_sec_xyz123
