{
  "name": "@mandatepay/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@mandatepay/schemas": "workspace:*",
    "@mandatepay/scanner": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.21.0"
  }
}
