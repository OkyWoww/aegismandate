{
  "name": "aegismandate",
  "private": true,
  "version": "0.9.0-rc3",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start:all": "tsx scripts/dev.ts",
    "web:dev": "vite --port=3000 --host=0.0.0.0",
    "api:dev": "tsx apps/api/src/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc -b",
    "lint": "eslint . --ext .ts,.tsx,.js,.cjs",
    "test": "vitest run",
    "test:live-paypal": "tsx scripts/live-sandbox-test.ts",
    "test:paypal-capture-proof": "tsx scripts/paypal-capture-proof.ts",
    "test:concurrency": "tsx scripts/concurrency-bench.ts",
    "attack-suite": "vitest run packages/sim",
    "smoke": "tsx scripts/smoke.ts",
    "e2e:live": "tsx --env-file=.env scripts/live-e2e.ts",
    "seed": "tsx scripts/seed.ts",
    "verify-fresh-clone": "bash scripts/verify-fresh-clone.sh"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "8.57.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  }
